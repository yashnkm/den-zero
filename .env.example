# Copy to .env and fill in

# Postgres — reuse your existing server's instance.
# Create a dedicated database first:  createdb denzero
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/denzero

# Port the Node app listens on (nginx proxies to this)
PORT=8642

# Admin dashboard password (login page at /admin; sessions last 12h)
ADMIN_PASS=change-me-to-something-long
