# Copy to .env and fill in

# Postgres — reuse your existing server's instance.
# Create a dedicated database first:  createdb denzero
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/denzero

# Port the Node app listens on (nginx proxies to this)
PORT=8642

# Admin dashboard password (login page at /admin; sessions last 12h)
ADMIN_PASS=change-me-to-something-long

# Razorpay — Dashboard → Account & Settings → API Keys (use rzp_test_… keys until go-live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your-domain>/api/razorpay/webhook, events
# payment.captured, payment.failed, order.paid; paste the same secret here
RAZORPAY_WEBHOOK_SECRET=

# Testing only: temporary per-city fees in ₹. Remove before launch.
# CITY_FEE_OVERRIDES=Pune:1,Mumbai:2,Bangalore:3
